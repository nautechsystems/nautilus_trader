# Dockerfile to reproduce locally an environment similar to what is run on the github runner
#
# From nautilus project's root folder:
#
# Pull base images with bounded retry:
# bash scripts/ci/docker-pull-retry.sh --from-dockerfile .docker/DockerfileUbuntu
#
# Build the image:
# docker build -f .docker/DockerfileUbuntu -t nautilus-dev .
#
# Run interactively with local directory mounted:
# docker run --rm -itv "$(pwd)":/workspace nautilus-dev bash
#
# Or run the default entrypoint:
# docker run --rm -itv "$(pwd)":/workspace nautilus-dev
#
# Remove the image
# docker image rm nautilus-dev

FROM public.ecr.aws/docker/library/rust:1.98.0-slim-bookworm@sha256:94e9efa4033213dbb70d4f665527e7ece3944ddb7ba1dd2e43f6fd6e2490af58 AS rust-toolchain

# Pin to specific digest for supply-chain security (ubuntu:22.04 as of 2026-04-30)
FROM public.ecr.aws/docker/library/ubuntu@sha256:962f6cadeae0ea6284001009daa4cc9a8c37e75d1f5191cf0eb83fe565b63dd7
# Set environment variables
ENV DEBIAN_FRONTEND=noninteractive
ENV RUST_BACKTRACE=1
ENV CARGO_INCREMENTAL=0
ENV CC="clang"
ENV CXX="clang++"

# Install system dependencies
RUN apt-get update && apt-get install -y \
    curl \
    clang \
    lld \
    git \
    pkg-config \
    make \
    capnproto \
    libcapnp-dev \
    patchelf \
    gcc-aarch64-linux-gnu \
    && rm -rf /var/lib/apt/lists/*

# Install Rust
COPY --from=rust-toolchain /usr/local/cargo /usr/local/cargo
COPY --from=rust-toolchain /usr/local/rustup /usr/local/rustup
ENV CARGO_HOME="/usr/local/cargo" \
    RUSTUP_HOME="/usr/local/rustup" \
    PATH="/usr/local/cargo/bin:${PATH}"

# Set working directory
WORKDIR /workspace

# Install uv
COPY --from=ghcr.io/astral-sh/uv:0.12.5@sha256:e85be844203885286c60ffad8a858d48afb6c5a5c237ca0e67f12e74b8f174b1 \
  /uv /uvx /root/.local/bin/
ENV PATH="/root/.local/bin:${PATH}"

# Install Python 3.13
RUN uv python install 3.13

# Copy only necessary files for dependency setup
# The actual source code will be mounted as a volume
COPY scripts/rust-toolchain.sh scripts/
COPY Cargo.toml Cargo.lock rust-toolchain.toml ./

# Set up Rust toolchain based on project requirements
RUN bash scripts/rust-toolchain.sh > /tmp/toolchain.txt && \
    TOOLCHAIN=$(cat /tmp/toolchain.txt) && \
    rustup toolchain install $TOOLCHAIN && \
    rustup default $TOOLCHAIN && \
    rustup component add clippy rustfmt

# Copy and set up entrypoint script for interactive development
COPY .docker/entrypoint.sh /entrypoint.sh
RUN chmod +x /entrypoint.sh

ENTRYPOINT ["/entrypoint.sh"]
